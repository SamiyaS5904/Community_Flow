# =========================================================
# CommunityFlow — Environment Variables
# =========================================================
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit the real .env file to version control.
# =========================================================

# ── AI API Keys ─────────────────────────────────────────
OPENAI_API_KEY=sk-replace-with-your-openai-key
ANTHROPIC_API_KEY=                          # optional, not used in primary pipeline

# ── Telegram ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id       # Chat ID for the default (placement_prep) group
TELEGRAM_ADMIN_CHAT_ID=replace-with-admin-chat-id

# ── Telegram — Optional additional groups ───────────────
TELEGRAM_CHAT_ID_CAT_PREP=                  # Chat ID for the cat_prep group


# ── Search (Serper API) ─────────────────────────────────
SEARCH_API_KEY=replace-with-your-serper-api-key
SEARCH_API_PROVIDER=serper

# ── Flask Dashboard ─────────────────────────────────────
DASHBOARD_PASSWORD=replace-with-a-strong-password

# REQUIRED: Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The app will REFUSE TO START if this is not set.
FLASK_SECRET_KEY=replace-with-a-long-random-hex-string

# ── Runtime ─────────────────────────────────────────────
ENVIRONMENT=dev                             # "dev" or "production"

# ── Model selection (optional) ──────────────────────────────
# Default for every agent. Leave unset to use gpt-4o-mini.
OPENAI_MODEL=
# Per-agent overrides. Spend on the steps whose output a reader sees;
# leave the JSON-emitting steps on the cheap model.
OPENAI_MODEL_WRITER=
OPENAI_MODEL_QA=
OPENAI_MODEL_PDF=
OPENAI_MODEL_RESEARCH=
OPENAI_MODEL_PLANNER=
OPENAI_MODEL_MAPPER=
OPENAI_MODEL_ASSET_PLANNER=
